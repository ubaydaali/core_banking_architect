>>SOURCE FORMAT IS FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. HYDRA-CORE.
AUTHOR. META-ARCHITECT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT MASTER-IN ASSIGN TO 'data/input/master_old.dat' ORGANIZATION IS LINE SEQUENTIAL.
    SELECT TRANS-IN  ASSIGN TO 'data/input/transactions.dat' ORGANIZATION IS LINE SEQUENTIAL.
    SELECT RATES-IN  ASSIGN TO 'data/input/rates.dat' ORGANIZATION IS LINE SEQUENTIAL.
    SELECT MASTER-OUT ASSIGN TO 'data/output/master_new.dat' ORGANIZATION IS LINE SEQUENTIAL.
    SELECT SWIFT-OUT  ASSIGN TO 'data/output/swift_msgs.txt' ORGANIZATION IS LINE SEQUENTIAL.
    SELECT AUDIT-OUT  ASSIGN TO 'data/output/audit_report.txt' ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD MASTER-IN.
01 M-REC.
   05 M-ID          PIC X(5).
   05 M-NAME        PIC X(20).
   05 M-BAL         PIC S9(7)V99 SIGN LEADING SEPARATE.

FD TRANS-IN.
01 T-REC.
   05 T-ID          PIC X(5).
   05 T-TYPE        PIC X(3).
   05 T-AMOUNT      PIC 9(7)V99.
   05 T-CURRENCY    PIC X(3).

FD RATES-IN.
01 R-REC.
   05 R-CURRENCY    PIC X(3).
   05 R-RATE        PIC 9V9(4).

FD MASTER-OUT.
01 MO-REC.
   05 MO-ID         PIC X(5).
   05 MO-NAME       PIC X(20).
   05 MO-BAL        PIC S9(7)V99 SIGN LEADING SEPARATE.

FD SWIFT-OUT.
01 SWIFT-REC        PIC X(80).

FD AUDIT-OUT.
01 AUDIT-REC        PIC X(80).

WORKING-STORAGE SECTION.
01 WS-RATE-TABLE.
   05 RATE-ENTRY OCCURS 5 TIMES INDEXED BY RATE-IDX.
      10 RATE-CUR   PIC X(3).
      10 RATE-VAL   PIC 9V9(4).
01 WS-RATE-COUNT    PIC 9 VALUE 0.
01 WS-EOF-R         PIC X VALUE 'N'.

01 CURR-REC.
   05 CURR-ID       PIC X(5).
   05 CURR-NAME     PIC X(20).
   05 CURR-BAL      PIC S9(7)V99 SIGN LEADING SEPARATE.

01 WS-CONVERTED-AMT PIC 9(7)V99.
01 WS-ACTUAL-RATE   PIC 9V9(4).

01 WS-MASKED-NAME   PIC X(20).
01 WS-REV-NAME      PIC X(20).
01 WS-NAME-LEN      PIC 9(2).
01 WS-ACTUAL-LEN    PIC 9(2).
01 I                PIC 9(2).

01 WS-SWIFT-FMT     PIC X(80).
01 WS-AUDIT-FMT     PIC X(80).
01 WS-DISP-BAL      PIC -9(7).99.

PROCEDURE DIVISION.
0000-MAIN.
    OPEN INPUT MASTER-IN TRANS-IN RATES-IN
    OPEN OUTPUT MASTER-OUT SWIFT-OUT AUDIT-OUT
    
    PERFORM 1000-LOAD-RATES UNTIL WS-EOF-R = 'Y' OR WS-RATE-COUNT = 5
    
    PERFORM 2000-READ-MASTER
    PERFORM 2100-READ-TRANS
    
    PERFORM 3000-BALANCE-LINE UNTIL M-ID = HIGH-VALUES AND T-ID = HIGH-VALUES
    
    CLOSE MASTER-IN TRANS-IN RATES-IN
    CLOSE MASTER-OUT SWIFT-OUT AUDIT-OUT
    STOP RUN.

1000-LOAD-RATES.
    READ RATES-IN 
        AT END MOVE 'Y' TO WS-EOF-R
        NOT AT END 
            ADD 1 TO WS-RATE-COUNT
            MOVE R-CURRENCY TO RATE-CUR (WS-RATE-COUNT)
            MOVE R-RATE TO RATE-VAL (WS-RATE-COUNT)
    END-READ.

2000-READ-MASTER.
    READ MASTER-IN 
        AT END MOVE HIGH-VALUES TO M-ID
    END-READ.

2100-READ-TRANS.
    READ TRANS-IN 
        AT END MOVE HIGH-VALUES TO T-ID
    END-READ.

3000-BALANCE-LINE.
    IF M-ID < T-ID
        MOVE M-REC TO CURR-REC
        PERFORM 4000-WRITE-MASTER
        PERFORM 2000-READ-MASTER
    ELSE IF M-ID = T-ID
        MOVE M-REC TO CURR-REC
        PERFORM 2000-READ-MASTER
        PERFORM UNTIL T-ID NOT = CURR-ID
            PERFORM 3500-APPLY-TRANS
            PERFORM 2100-READ-TRANS
        END-PERFORM
        PERFORM 4000-WRITE-MASTER
    ELSE
        MOVE T-ID TO CURR-ID
        MOVE 'NEW CUSTOMER        ' TO CURR-NAME
        MOVE 0 TO CURR-BAL
        PERFORM UNTIL T-ID NOT = CURR-ID
            PERFORM 3500-APPLY-TRANS
            PERFORM 2100-READ-TRANS
        END-PERFORM
        PERFORM 4000-WRITE-MASTER
    END-IF.

3500-APPLY-TRANS.
    SET RATE-IDX TO 1
    SEARCH RATE-ENTRY
        AT END MOVE 1.0000 TO WS-ACTUAL-RATE
        WHEN RATE-CUR (RATE-IDX) = T-CURRENCY
            MOVE RATE-VAL (RATE-IDX) TO WS-ACTUAL-RATE
    END-SEARCH
    
    COMPUTE WS-CONVERTED-AMT = T-AMOUNT * WS-ACTUAL-RATE
    
    IF T-TYPE = 'DEP'
        ADD WS-CONVERTED-AMT TO CURR-BAL
    ELSE IF T-TYPE = 'WDL' OR T-TYPE = 'XFR'
        SUBTRACT WS-CONVERTED-AMT FROM CURR-BAL
    END-IF
    
    IF T-TYPE = 'XFR'
        INITIALIZE WS-SWIFT-FMT
        STRING 'MT103|F20:' CURR-ID '|F32A:' T-CURRENCY '|F50K:' CURR-NAME 
            DELIMITED BY SIZE INTO WS-SWIFT-FMT
        WRITE SWIFT-REC FROM WS-SWIFT-FMT
    END-IF.

4000-WRITE-MASTER.
    MOVE CURR-REC TO MO-REC
    WRITE MO-REC
    
    MOVE CURR-NAME TO WS-MASKED-NAME
    MOVE FUNCTION REVERSE(WS-MASKED-NAME) TO WS-REV-NAME
    MOVE 0 TO WS-NAME-LEN
    INSPECT WS-REV-NAME TALLYING WS-NAME-LEN FOR LEADING SPACES
    COMPUTE WS-ACTUAL-LEN = 20 - WS-NAME-LEN
    
    IF WS-ACTUAL-LEN > 2
        PERFORM VARYING I FROM 2 BY 1 UNTIL I >= WS-ACTUAL-LEN
            MOVE '*' TO WS-MASKED-NAME(I:1)
        END-PERFORM
    END-IF
    
    MOVE CURR-BAL TO WS-DISP-BAL
    INITIALIZE WS-AUDIT-FMT
    STRING 'ID:' CURR-ID ' | NAME:' WS-MASKED-NAME ' | BAL:' WS-DISP-BAL
        DELIMITED BY SIZE INTO WS-AUDIT-FMT
    WRITE AUDIT-REC FROM WS-AUDIT-FMT.
